# .gitignore — AIT Monorepo

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment files (NEVER commit these)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build outputs
dist/
build/
.next/
out/
**/dist/
**/build/

# Bun
bun.lockb

# Vite & TS
*.local
*.tsbuildinfo
**/*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
